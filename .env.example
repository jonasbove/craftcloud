# Copy to .env (git-ignored) and edit.

# Database password (Postgres runs as a second compose service). Use a long random value:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# The URL people use to reach CraftCloud, as typed in the browser (share links, editors).
CRAFTCLOUD_PUBLIC_URL=http://localhost:8086

# Where the container's port is published on the host. Keep 127.0.0.1 behind a reverse proxy;
# use 0.0.0.0 to expose it directly on the network.
CRAFTCLOUD_BIND=127.0.0.1
CRAFTCLOUD_HOST_PORT=8086

# OxiCloud's own apps are removed by default. Turn some back on (comma-separated):
#   music, collab (Markdown editor), dav (CalDAV/CardDAV), all
CRAFTCLOUD_NATIVE_APPS=

# Craft web apps in the browser (off by default). Needs the image with the apps bundled:
# CRAFTCLOUD_IMAGE=ghcr.io/jonasbove/craftcloud:<ver>-apps
CRAFTCLOUD_WEB_APPS=off

# Sign-in limits (OxiCloud's): attempts per client address per window, and failures before an account is
# locked for 15 minutes. The defaults suit most servers; a school or office behind one public address may
# need more.
# OXICLOUD_RATE_LIMIT_LOGIN_MAX=10
# OXICLOUD_RATE_LIMIT_LOGIN_WINDOW_SECS=60
# OXICLOUD_LOCKOUT_MAX_FAILURES=5

# Single sign-on with an OpenID Connect provider (docs/OIDC.md). Easier in the browser: Admin › Server ›
# Single sign-on. Anything set here wins over the admin page, which then shows it as read-only. Register
# <CRAFTCLOUD_PUBLIC_URL>/api/auth/oidc/callback as the redirect URI at the provider.
# OXICLOUD_OIDC_ENABLED=true
# OXICLOUD_OIDC_ISSUER_URL=https://id.example.com
# OXICLOUD_OIDC_CLIENT_ID=craftcloud
# OXICLOUD_OIDC_CLIENT_SECRET=
# OXICLOUD_OIDC_SCOPES="openid profile email groups"
# OXICLOUD_OIDC_PROVIDER_NAME="Example ID"        (the button says "Sign in with Example ID")
# OXICLOUD_OIDC_AUTO_PROVISION=true                (create an account at first sign-in)
# OXICLOUD_OIDC_ADMIN_GROUPS=craftcloud-admins     (comma-separated; decided when the account is created)
# OXICLOUD_OIDC_AUTO_LINK_EMAIL_MATCH=true         (join an existing account with the same verified email)
# OXICLOUD_OIDC_DISABLE_PASSWORD_LOGIN=false       (true: single sign-on only)

# Behind HTTPS, mark session cookies Secure.
OXICLOUD_COOKIE_SECURE=false

# Image to run. Default: ghcr.io/jonasbove/craftcloud:latest. Pin a version to choose when you update,
# e.g. ghcr.io/jonasbove/craftcloud:0.1.1 (or :0.1.0-apps). `docker compose build` builds it from
# this checkout instead.
# CRAFTCLOUD_IMAGE=ghcr.io/jonasbove/craftcloud:0.1.1

# Any other OxiCloud setting works too (OXICLOUD_*), see upstream/oxicloud/docs/config/env.md.

# Who may tell CraftCloud the real client address (X-Forwarded-For): your reverse proxy's address,
# e.g. 172.18.0.1/32. Default: any private address. If clients reach CraftCloud directly on a LAN,
# set 127.0.0.1/32 so nobody can fake their address to get around the sign-in limits.
# CRAFTCLOUD_TRUSTED_PROXIES=private_ranges
