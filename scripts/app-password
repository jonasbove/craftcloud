#!/bin/sh
# Create an app password for WebDAV clients (file managers, rclone, DAVx5). OxiCloud's WebDAV accepts
# app passwords, not your account password. Until the web settings have an "App passwords" panel:
#
#   scripts/app-password https://cloud.example.org [label]
#
# Asks for your username and password (not stored), prints the new app password once.
# For tests: CRAFTCLOUD_USER and CRAFTCLOUD_PASSWORD skip the prompts.
set -eu

SERVER="${1:?usage: scripts/app-password <server-url> [label]}"
SERVER="${SERVER%/}"
LABEL="${2:-WebDAV on $(hostname)}"

user="${CRAFTCLOUD_USER:-}"
pass="${CRAFTCLOUD_PASSWORD:-}"
if [ -z "$user" ]; then printf 'Username: '; read -r user; fi
if [ -z "$pass" ]; then
    printf 'Password: '
    stty -echo 2>/dev/null || true
    read -r pass
    stty echo 2>/dev/null || true
    echo
fi

json() { python3 -I -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

login="$(curl -fsS -H 'Content-Type: application/json' \
    -d "{\"username\": $(json "$user"), \"password\": $(json "$pass")}" "$SERVER/api/auth/login")" || {
    echo "Sign-in failed: check the address, username and password." >&2
    exit 1
}
token="$(printf '%s' "$login" | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["access_token"])')"

created="$(curl -fsS -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -d "{\"label\": $(json "$LABEL"), \"scopes\": \"webdav\"}" "$SERVER/api/auth/app-passwords")"

printf '%s' "$created" | SERVER="$SERVER" python3 -I -c '
import json, os, sys
d = json.load(sys.stdin)
user, password = d["username"], d["password"]
s = os.environ["SERVER"]
host = s.split("://", 1)[1]
print()
print("App password created (shown once; revoke it via the API until the web settings have a page for it).")
print()
print(f"  Username:      {user}")
print(f"  App password:  {password}")
print(f"  WebDAV URL:    {s}/webdav/")
print()
print(f"  File manager:  dav://{host}/webdav/   (davs:// once the server has HTTPS)")
print(f"  rclone:        rclone config create craftcloud webdav url={s}/webdav/ vendor=other user={user} pass=$(rclone obscure \"<app password>\")")
print(f"                 rclone bisync ~/CraftCloud craftcloud: --resync   (first run; then without --resync)")
'
