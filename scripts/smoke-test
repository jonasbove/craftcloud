#!/bin/sh
# Smoke-test a CraftCloud image: start it with Postgres under its own compose project, check what the
# image promises, then tear everything down (volumes included).
#
# Usage: scripts/smoke-test [image] [host-port]     (defaults: craftcloud:dev 8093)
#        WEB_APPS=on scripts/smoke-test craftcloud:dev-apps
#                                                   web apps on (needs the -apps image)
#        KEEP=1 scripts/smoke-test ...               leave the stack running afterwards, still without an owner
#                                                   (the release's package test makes its own; SMOKE_SIGN_IN=1 signs
#                                                   in anyway, which creates the owner `smoke`)
set -eu

IMAGE="${1:-craftcloud:dev}"
PORT="${2:-8093}"
WEB_APPS="${WEB_APPS:-off}"  # PUBLIC_URL=… overrides the public address (e.g. for screenshots)
PROJECT="${PROJECT:-craftcloud-smoke}"  # several can run side by side: PROJECT=craftcloud-x
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BASE="http://127.0.0.1:${PORT}"
ENVFILE="$(mktemp)"
fail=0

cat > "$ENVFILE" <<EOF
POSTGRES_PASSWORD=smoke-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
CRAFTCLOUD_PUBLIC_URL=${PUBLIC_URL:-$BASE}
CRAFTCLOUD_BIND=127.0.0.1
CRAFTCLOUD_HOST_PORT=${PORT}
CRAFTCLOUD_IMAGE=${IMAGE}
CRAFTCLOUD_ENV_FILE=${ENVFILE}
CRAFTCLOUD_WEB_APPS=${WEB_APPS}
EOF

compose() { docker compose -p "$PROJECT" -f "$ROOT/compose.yaml" --env-file "$ENVFILE" "$@"; }

cleanup() {
    if [ "${KEEP:-0}" != 1 ]; then compose down -v >/dev/null 2>&1 || true; fi
    rm -f "$ENVFILE" "${JAR:-}"
}
trap cleanup EXIT

compose up -d --no-build --quiet-pull

printf 'waiting for /ready'
i=0
until curl -fsS -o /dev/null "$BASE/ready" 2>/dev/null; do
    i=$((i + 1))
    if [ "$i" -gt 90 ]; then echo; echo "not ready after 180 s"; compose logs --tail 60; exit 1; fi
    printf .; sleep 2
done
echo " ok"

check() { # name, command...
    name="$1"; shift
    if out="$("$@" 2>&1)"; then echo "PASS $name"; else echo "FAIL $name: $out"; fail=1; fi
}
header() { # url, header-name → value (body discarded)
    curl -sS -o /dev/null -D - -H 'Accept-Encoding: br, gzip' "$1" | tr -d '\r' | awk -v h="$(echo "$2" | tr A-Z a-z)" 'BEGIN{FS=": "} tolower($1)==h {print $2}' | tail -1
}
expect() { # actual, expected
    [ "$1" = "$2" ] || { echo "got '$1', want '$2'"; return 1; }
}
status() { curl -sS -o /dev/null -w '%{http_code}' "$1"; }

check "CraftCloud frontend at /" sh -c "curl -fsS '$BASE/' | grep -q 'craftcloud_canvas'"
check "/device is the frontend too" sh -c "curl -fsS '$BASE/device?code=AB-12' | grep -q 'craftcloud_canvas'"
check "OxiCloud's own pages are gone" sh -c "! curl -fsS '$BASE/login' | grep -q '<base href='"
check "OxiCloud API passes through" sh -c "curl -fsS '$BASE/api/auth/status' | grep -q initialized"
check "health" sh -c "curl -fsS '$BASE/health' >/dev/null"
check "frontend pages DENY framing" expect "$(header "$BASE/" x-frame-options)" DENY
# Strict-Transport-Security only when the public address is https, on every kind of answer.
case "${PUBLIC_URL:-$BASE}" in
    https://*) want_hsts="max-age=15552000" ;;
    *) want_hsts="" ;;
esac
check "HSTS '$want_hsts' on the frontend" expect "$(header "$BASE/" strict-transport-security)" "$want_hsts"
check "HSTS '$want_hsts' on the API" expect "$(header "$BASE/api/auth/status" strict-transport-security)" "$want_hsts"
check "HSTS '$want_hsts' on a blocked path" expect "$(header "$BASE/caldav/" strict-transport-security)" "$want_hsts"
FWASM="$(curl -fsS "$BASE/" | grep -o 'craftcloud-web-[0-9a-f]*_bg\.wasm' | head -1)"
check "frontend wasm found" test -n "$FWASM"
check "frontend wasm precompressed (br)" expect "$(header "$BASE/$FWASM" content-encoding)" br
check "frontend wasm content-type" expect "$(header "$BASE/$FWASM" content-type)" application/wasm
check "CalDAV blocked" expect "$(status "$BASE/caldav/")" 404
check "CardDAV well-known blocked" expect "$(status "$BASE/.well-known/carddav")" 404
check "WebDAV still answers (auth required)" expect "$(status "$BASE/webdav/")" 401
redirect() { curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' "$1"; }
check "SSO: a provider's error= lands on the sign-in page" expect "$(redirect "$BASE/api/auth/oidc/callback?error=access_denied&state=x")" "302 $BASE/login?login_error=provider_denied"
check "SSO: a failed callback lands on the sign-in page" expect "$(redirect "$BASE/api/auth/oidc/callback")" "302 $BASE/login?login_error=callback_failed"
check "SSO: a failed authorize lands on the sign-in page" expect "$(redirect "$BASE/api/auth/oidc/authorize")" "302 $BASE/login?login_error=provider_unreachable"
check "config.json served as JSON" expect "$(header "$BASE/craftcloud/config.json" content-type)" application/json
# `web_apps` (true or false) from config.json; the web apps checks below compare it.
web_apps_json="$(curl -fsS "$BASE/craftcloud/config.json" | tr '\n' ' ' | sed -n -E 's/^[[:space:]]*\{.*"web_apps"[[:space:]]*:[[:space:]]*(true|false)([^[:alnum:]_].*)?\}[[:space:]]*$/\1/p')"
check "config.json is an object with web_apps" sh -c "[ -n '$web_apps_json' ]"

check "settings API needs sign-in" expect "$(status "$BASE/craftcloud/api/settings")" 401
check "the admin gate is not reachable from outside" expect "$(status "$BASE/internal/apps-gate")" 200
check "…it is the frontend there, not the gate" sh -c "curl -fsS '$BASE/internal/apps-gate' | grep -q craftcloud_canvas"

# Signing in creates the owner `smoke`. A server kept running (KEEP=1) stays without an owner, because whoever
# uses it next makes the first account (the release's package test does); SMOKE_SIGN_IN=1 signs in anyway. The
# web-apps checks below need the sign-in.
if [ "${SMOKE_SIGN_IN:-}" = 1 ] || [ "${KEEP:-0}" != 1 ] || [ "$WEB_APPS" != off ]; then
    # Create the owner and sign in (the cookie jar keeps the session for the checks below).
    JAR="$(mktemp)"
    PW="smoke-$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
    curl -fsS -o /dev/null -H 'Content-Type: application/json' -d "{\"username\":\"smoke\",\"email\":\"smoke@example.org\",\"password\":\"$PW\"}" "$BASE/api/setup"
    LOGIN_HEADERS="$(curl -fsS -o /dev/null -D - -c "$JAR" -H 'Content-Type: application/json' -d "{\"username\":\"smoke\",\"password\":\"$PW\"}" "$BASE/api/auth/login" | tr -d '\r')"
    CSRF="$(awk '$6=="oxicloud_csrf"{print $7}' "$JAR")"

    # The sign-in cookie is Secure exactly when the public address is https (read from Set-Cookie, since
    # curl may not keep a Secure cookie it got over http).
    case "${PUBLIC_URL:-$BASE}" in
        https://*) want_secure=yes ;;
        *) want_secure=no ;;
    esac
    access_cookie="$(printf '%s\n' "$LOGIN_HEADERS" | grep -i '^set-cookie: *oxicloud_access=' | head -1)"
    check "sign-in cookie set" test -n "$access_cookie"
    if printf '%s' "$access_cookie" | grep -qi '; *secure\(;\|$\)'; then got_secure=yes; else got_secure=no; fi
    check "sign-in cookie Secure: $want_secure for ${PUBLIC_URL:-$BASE}" expect "$got_secure" "$want_secure"
else
    echo "skip  sign-in cookie checks (KEEP=1 leaves the server without an owner; SMOKE_SIGN_IN=1 runs them)"
fi

if [ "$WEB_APPS" = off ]; then
    check "config says web apps off" expect "$web_apps_json" false
    check "web apps not served" expect "$(status "$BASE/apps/wordcraft/index.html")" 404
else
    check "config says web apps on" expect "$web_apps_json" true
    check "apps manifest lists 15 apps" sh -c "curl -fsS '$BASE/craftcloud/apps.json' | grep -c '\"entry\"' | grep -qx 15"
    for app in $(curl -fsS "$BASE/craftcloud/apps.json" | sed -n 's/.*"id": "\([a-z0-9-]*\)".*/\1/p'); do
        check "$app index.html 200" expect "$(status "$BASE/apps/$app/index.html")" 200
    done
    W="$BASE/apps/wordcraft"
    WASM="$(curl -fsS "$W/index.html" | grep -o 'wordcraft-web-[0-9a-f]*_bg\.wasm' | head -1)"
    check "wordcraft wasm found in index.html" test -n "$WASM"
    check "wasm content-type" expect "$(header "$W/$WASM" content-type)" application/wasm
    check "wasm precompressed (br)" expect "$(header "$W/$WASM" content-encoding)" br
    check "wasm 200, not 206" expect "$(curl -sS -o /dev/null -w '%{http_code}' -H 'Accept-Encoding: br' "$W/$WASM")" 200
    check "wasm immutable" expect "$(header "$W/$WASM" cache-control)" "public, max-age=31536000, immutable"
    check "app page frameable same-origin" expect "$(header "$W/index.html" x-frame-options)" SAMEORIGIN
    check "app page no-cache" expect "$(header "$W/index.html" cache-control)" no-cache
    check "app dir redirects to index.html" expect "$(curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' "$W/")" "308 $W/index.html"
    check "_headers hidden" expect "$(status "$W/_headers")" 404
    check "dotfiles hidden" expect "$(status "$BASE/apps/photocraft/.htaccess")" 404
    check "photocraft fixup present" expect "$(status "$BASE/apps/photocraft/app/snippets/eframe-d31a8450ea12dfc1/inline0.js")" 200

    # Switch one app off as the owner, through the same API the admin page uses.
    BODY='{"web_apps": true, "disabled_apps": ["effectcraft"]}'
    check "settings write without CSRF refused" expect "$(curl -sS -o /dev/null -w '%{http_code}' -b "$JAR" -X PUT -H 'Content-Type: application/json' -d "$BODY" "$BASE/craftcloud/api/settings")" 403
    check "settings write as owner" expect "$(curl -sS -o /dev/null -w '%{http_code}' -b "$JAR" -X PUT -H 'Content-Type: application/json' -H "X-CSRF-Token: $CSRF" -d "$BODY" "$BASE/craftcloud/api/settings")" 200
    check "a switched-off app is gone at once" expect "$(status "$BASE/apps/effectcraft/index.html")" 404
    check "other apps stay" expect "$(status "$BASE/apps/wordcraft/index.html")" 200
    check "config lists only enabled apps" sh -c "curl -fsS '$BASE/craftcloud/config.json' | grep -q wordcraft && ! curl -fsS '$BASE/craftcloud/config.json' | grep -q effectcraft"
fi

if [ "$fail" = 0 ]; then echo "all checks passed"; else echo "some checks failed"; fi
exit "$fail"
