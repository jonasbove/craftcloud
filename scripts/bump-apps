#!/usr/bin/env python3
"""Update the pins (version, asset, sha256) in apps.toml from each app's latest GitHub release.

Usage: scripts/bump-apps [--check] [app ...]

Only the three pin lines inside each [apps.<id>] table are rewritten; every other line is kept
as written, so hand-edited fields (associations, bridge, notes) survive a bump. The sha256 comes
from the GitHub release API's asset `digest`. Set GITHUB_TOKEN to avoid the 60 requests/hour limit.

--check  report what would change and exit 1 if anything is out of date; write nothing.
"""
import json
import os
import re
import sys
import tomllib
import urllib.request
from pathlib import Path

MANIFEST = Path(__file__).resolve().parent.parent / "apps.toml"


def latest_web_asset(repo: str, app: str):
    req = urllib.request.Request(
        f"https://api.github.com/repos/{repo}/releases?per_page=10",
        headers={"Accept": "application/vnd.github+json", "User-Agent": "craftcloud-bump-apps"},
    )
    if token := os.environ.get("GITHUB_TOKEN"):
        req.add_header("Authorization", f"Bearer {token}")
    with urllib.request.urlopen(req, timeout=30) as resp:
        releases = json.load(resp)
    pattern = re.compile(rf"^{re.escape(app)}-web-(\d+\.\d+\.\d+)\.zip$")
    for rel in releases:  # newest first; skip drafts and pre-releases
        if rel.get("draft") or rel.get("prerelease"):
            continue
        for asset in rel["assets"]:
            if m := pattern.match(asset["name"]):
                digest = asset.get("digest") or ""
                if not digest.startswith("sha256:"):
                    sys.exit(f"{app}: release {rel['tag_name']} asset has no sha256 digest")
                return m.group(1), asset["name"], digest.removeprefix("sha256:"), rel["tag_name"]
    return None


def set_pin(text: str, app: str, key: str, value: str) -> str:
    # Replace `key = "..."` inside the [apps.<app>] table only.
    table = re.compile(rf"(^\[apps\.{re.escape(app)}\]\n)(.*?)(?=^\[|\Z)", re.S | re.M)
    m = table.search(text)
    if not m:
        sys.exit(f"{app}: no [apps.{app}] table")
    body, n = re.subn(rf'^({key}\s*=\s*)"[^"]*"', rf'\g<1>"{value}"', m.group(2), count=1, flags=re.M)
    if n != 1:
        sys.exit(f"{app}: no `{key}` line")
    return text[: m.start(2)] + body + text[m.end(2):]


def main(argv):
    check = "--check" in argv
    only = [a for a in argv if not a.startswith("--")]
    text = MANIFEST.read_text()
    apps = tomllib.loads(text)["apps"]
    stale = False
    for app, spec in apps.items():
        if only and app not in only:
            continue
        found = latest_web_asset(spec["repo"], app)
        if not found:
            print(f"{app:14} no web asset in recent releases, kept {spec['version']}")
            continue
        version, asset, sha, tag = found
        if (version, asset, sha) == (spec["version"], spec["asset"], spec["sha256"]):
            print(f"{app:14} {version} up to date")
            continue
        stale = True
        print(f"{app:14} {spec['version']} -> {version} ({tag})")
        for key, value in (("version", version), ("asset", asset), ("sha256", sha)):
            text = set_pin(text, app, key, value)
    if check:
        return 1 if stale else 0
    MANIFEST.write_text(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
